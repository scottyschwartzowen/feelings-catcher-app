{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firebase.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.rules",
      ".firebaserc",
      "README.md",
      "functions/**",
      "**/node_modules/**",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
