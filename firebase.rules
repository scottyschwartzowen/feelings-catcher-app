rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feelings/{id} {
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.entry is string
                    && request.resource.data.entry.size() <= 5000;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.entry.size() <= 5000;
      allow delete: if request.auth != null
                    && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // Reminder settings: one document per user, only that user can touch it
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notification registrations: a user can manage only the devices in their own account
    match /users/{userId}/notificationInstallations/{installationId} {
      allow read, create, update, delete: if request.auth != null
                                          && request.auth.uid == userId;
    }
  }
}
